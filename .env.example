# Zorkaliser Backend Configuration
PORT=3001
HOST=127.0.0.1

# Provider selection:
# - auto: picks Gemini if GEMINI_API_KEY is set, else OpenAI/FAL if set, else built-in mock provider
# - gemini | openai | lemonade | mock
LLM_PROVIDER=auto
# - auto | gemini | imagen | fal | openai | lemonade | mock
IMAGE_PROVIDER=auto

# === Google Gemini (Cloud Stage 1 / Stage 2) ===
# Get a key at https://aistudio.google.com/apikey
# Note: Google AI Studio requires billing enabled for Gemini image generation models.
# To use Gemini for Stage 1 Scene Direction + Lemonade Server for local images, set:
#   LLM_PROVIDER=gemini
#   IMAGE_PROVIDER=lemonade
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_HIGH_MODEL=gemini-3-pro-image

# === Local AI / Lemonade Server (OpenAI-compatible /v1 API) ===
# Default port is 13305. If running on another LAN machine, start Lemonade with --host 0.0.0.0.
LEMONADE_BASE_URL=http://192.168.0.64:13305/v1
LEMONADE_API_KEY=lemonade
LEMONADE_LLM_MODEL=
LEMONADE_IMAGE_MODEL=SDXL-Turbo
# Optional sd-cpp tuning (leave blank to use the model's Lemonade recipe defaults)
LEMONADE_IMAGE_STEPS=
LEMONADE_IMAGE_CFG_SCALE=
LEMONADE_TIMEOUT_MS=120000

# === Optional Additional Providers ===
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

FAL_KEY=
FAL_FAST_MODEL=fal-ai/flux/schnell
FAL_BALANCED_MODEL=fal-ai/flux/dev

# === Storage, Caching & Safeguards ===
DATA_DIR=./data
RATE_LIMIT_MAX_GENERATIONS_PER_10M=30
DAILY_COST_CAP_USD=10.00
CORS_ORIGIN=http://localhost:5173
